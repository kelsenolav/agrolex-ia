         O sistema está auditando as páginas e extraindo os dados. Em instantes o dossiê técnico será disponibilizado.\r\n          </p>\r\n          <Link href=\"/dashboard\" className=\"text-sm font-semibold text-brand-green hover:underline\">\r\n            Retornar ao Centro de Inteligência\r\n          </Link>\r\n        </div>\r\n      </div>\r\n    );\r\n  }\r\n\r\n  if (isError) {\r\n    return (\r\n      <div className=\"min-h-screen flex flex-col items-center justify-center bg-gray-50 p-4\">\r\n        <div className=\"bg-white p-8 rounded-2xl shadow-xl max-w-md w-full text-center border-t-4 border-red-500\">\r\n          <div className=\"w-20 h-20 bg-red-100 text-red-500 rounded-full flex items-center justify-center mx-auto mb-6\">\r\n            <AlertTriangle size={40} />\r\n          </div>\r\n          <h2 className=\"text-2xl font-bold text-gray-800 mb-2\">Dossiê técnico indisponível</h2>\r\n          <p className=\"text-gray-600 mb-6\">Ocorreu um erro no processamento deste documento. Por favor, reenvie o arquivo.</p>\r\n          <Link href=\"/dashboard\" className=\"inline-block bg-brand-green text-white px-6 py-2.5 rounded-lg font-bold hover:brightness-110 transition-all\">\r\n            Retornar ao Centro de Inteligência\r\n          </Link>\r\n        </div>\r\n      </div>\r\n    );\r\n  }\r\n\r\n\r\n  const hasParecer = findings?.resumo && String(findings.resumo).trim().length > 0;\r\n\r\n  if (!isCompleted || !hasParecer) {\r\n    return (\r\n      <div className=\"min-h-screen flex flex-col items-center justify-center bg-gray-50 p-4\">\r\n        <div className=\"bg-white p-8 rounded-2xl shadow-xl max-w-md w-full text-center border-t-4 border-amber-500\">\r\n          <div className=\"w-20 h-20 bg-amber-100 text-amber-500 rounded-full flex items-center justify-center mx-auto mb-6\">\r\n            <AlertTriangle size={40} />\r\n          </div>\r\n          <h2 className=\"text-2xl font-bold text-gray-800 mb-2\">Anomalia: parecer não localizado</h2>\r\n          <p className=\"text-gray-600 mb-6\">O processamento consta como concluído, mas o parecer descritivo não pôde ser localizado.</p>\r\n          <Link href=\"/dashboard\" className=\"inline-block bg-brand-green text-white px-6 py-2.5 rounded-lg font-bold hover:brightness-110 transition-all\">\r\n            Retornar ao Centro de Inteligência\r\n          </Link>\r\n        </div>\r\n      </div>\r\n    );\r\n  }\r\n\r\n  const propName = analise.properties?.name || 'Propriedade';\r\n  const propLocation = `${analise.properties?.city || ''}, ${analise.properties?.state || ''}`;\r\n  \r\n  // P1B — Fonte primária: ISF v2, fallback: risk_level legado\r\n  const isfV2Findings = (findings as unknown as Record<string, unknown>)?.isf_v2 as Record<string, unknown> | undefined ?? null;\r\n  const isfV2RiskLabel = (isfV2Findings as any)?.risk_label || null;\r\n  const isfV2RiskLevel = (isfV2Findings as any)?.risk_level || null;\r\n  const risco = isfV2RiskLabel || analise.risk_level || \"Pendente\";\r\n  \r\n  let finalResumo = findings!.isHtmlResumo ? findings!.resumo : parseMarkdown(findings!.resumo);\r\n  const sanitizedResumo = DOMPurify.sanitize(finalResumo);\r\n\r\n  // P1B — getRiscoStyle usando taxonomy centralizada em vez de switch hardcoded\r\n  const getRiscoStyle = (r: string) => {\r\n    const taxonomyStyle = getISFStyle(r);\r\n    const taxonomyBgTint = getISFBgTint(r);\r\n    const taxonomyTextTint = getISFTextTint(r);\r\n    return {\r\n      bg: taxonomyBgTint,\r\n      border: taxonomyStyle.split(' ').find(c => c.startsWith('border-')) || 'border-gray-200',\r\n      text: taxonomyTextTint,\r\n      labelText: taxonomyStyle.split(' ').find(c => c.startsWith('text-') && c !== 'text-white') || 'text-gray-800',\r\n    };\r\n  };\r\n  const styles = getRiscoStyle(risco);\r\n\r\n  // ─── CADEIA DOMINIAL VISUAL ──────────────────────\r\n  const linhaDoTempo = safeLinhaDoTempo as TimelineEvent[];\r\n  \r\n  function renderCadeiaDominial() {\r\n    if (!linhaDoTempo || linhaDoTempo.length === 0) return null;\r\n    return (\r\n      <section className=\"print:break-inside-avoid border-t-2 border-gray-100 pt-8\">\r\n        <h2 className=\"text-2xl font-bold text-gray-900 mb-4 flex items-center gap-2 border-b border-gray-200 pb-3 uppercase tracking-wide\">\r\n          <Landmark className=\"text-brand-gold\" size={24} /> Cadeia Dominial Visual\r\n        </h2>\r\n        <div className=\"cadeia-dominial-flow\">\r\n          {linhaDoTempo.map((item: TimelineEvent, i: number) => {\r\n            const isUltimo = i === linhaDoTempo.length - 1;\r\n            const anoMatch = item.data?.match(/\\d{4}/);\r\n            const ano = anoMatch ? anoMatch[0] : item.data || '';\r\n            return (\r\n              <div key={i} className=\"cadeia-dominial-node\">\r\n                <div className=\"cadeia-dominial-timeline\">\r\n                  <div className=\"cadeia-dominial-dot\">{i + 1}</div>\r\n                  {!isUltimo && <div className=\"cadeia-dominial-connector\" />}\r\n                </div>\r\n                <div className=\"cadeia-dominial-card\">\r\n                  <span className=\"cadeia-ano\">{ano}</span>\r\n                  <span className=\"cadeia-evento\">{item.evento}</span>\r\n                  {item.detalhe && <span className=\"cadeia-detalhe\">{item.detalhe}</span>}\r\n                </div>\r\n              </div>\r\n            );\r\n          })}\r\n          {/* Node final — Proprietário Atual */}\r\n          <div className=\"cadeia-dominial-node\">\r\n            <div className=\"cadeia-dominial-timeline\">\r\n              <div className=\"cadeia-dominial-dot\">{linhaDoTempo.length + 1} </div>\r\n            </div>\r\n            <div className=\"cadeia-dominial-card border-brand-green/40 bg-green-50/40\">\r\n              <span className=\"cadeia-ano\">Atual</span>\r\n              <span className=\"cadeia-evento\">Proprietário Atual</span>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </section>\r\n    );\r\n  }\r\n\r\n\r\n\r\n  // ─── CHECKLIST INTELIGENTE ─────────────────────\r\n  const documentosBase = [\r\n    { nome: 'Matrícula', chave: 'matricula' },\r\n    { nome: 'Cadeia Dominial', chave: 'cadeia_dominial' },\r\n    { nome: 'Escritura', chave: 'escritura' },\r\n    { nome: 'CAR', chave: 'car' },\r\n    { nome: 'CCIR', chave: 'ccir' },\r\n    { nome: 'SIGEF', chave: 'sigef' },\r\n    { nome: 'Processo Administrativo', chave: 'processo_administrativo' },\r\n  ];\r\n\r\n  function verificarDocumento(chave: string): { presente: boolean; indicio: boolean } {\r\n    const docsRecebidos = safeDocuments.map(d => (d.document_type || d.file_path || '').toLowerCase()) || [];\r\n    const docsFaltantes = safeDocumentosFaltantes.map(d => d.toLowerCase());\r\n    const problemasTexto = safeProblemas.map(p => (p.titulo || p.descricao || '').toLowerCase()).join(' ');\r\n\r\n    // Verifica se o documento foi recebido (document_type ou file_path)\r\n    const foiRecebido = docsRecebidos.some(d => d.includes(chave.replace(/_/g, '')) || d.includes(chave));\r\n    // Se não está na lista de faltantes, pode ser um indício\r\n    const naoFaltante = !docsFaltantes.some(d => d.includes(chave.replace(/_/g, '')) || d.includes(chave));\r\n    // Verifica se há menção nos problemas\r\n    const mencionado = problemasTexto.includes(chave.replace(/_/g, ' ')) || problemasTexto.includes(chave);\r\n\r\n    if (foiRecebido) return { presente: true, indicio: false };\r\n    if (mencionado && naoFaltante) return { presente: false, indicio: true };\r\n    return { presente: false, indicio: false };\r\n  }\r\n\r\n  // ─── RESULTADOS POR CAMADA DE ANÁLISE ──────────\r\n  // `analise` e `findings` são garantidos não-null aqui (após early-return checks)\r\n  const analiseSafe = analise!;\r\n  const findingsSafe = findings!;\r\n\r\n  function renderResultadosPorCamada() {\r\n    if (childAnalyses.length === 0) return null;\r\n\r\n    return (\r\n      <section className=\"print:break-inside-avoid border-t-2 border-gray-100 pt-8\">\r\n        <h2 className=\"text-2xl font-bold text-gray-900 mb-4 flex items-center gap-2 border-b border-gray-200 pb-3 uppercase tracking-wide\">\r\n          <FileText className=\"text-brand-gold\" size={24} /> Resultados por Camada de Análise\r\n        </h2>\r\n        <p className=\"text-sm text-gray-500 mb-6\">\r\n          Este dossiê consolida resultados de múltiplas camadas de análise. Abaixo, cada camada é exibida separadamente para garantir a rastreabilidade.\r\n        </p>\r\n\r\n        {/* A. Análise Principal */}\r\n        <div className=\"mb-8 bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm\">\r\n          <div className=\"bg-brand-green text-white px-6 py-4 flex items-center justify-between\">\r\n            <div className=\"flex items-center gap-3\">\r\n              <ShieldCheck size={20} />\r\n              <span className=\"font-bold text-lg\">Análise Principal</span>\r\n            </div>\r\n            <span className=\"px-3 py-1 bg-white/20 text-white text-[10px] font-bold uppercase rounded-full\">\r\n              Camada 1\r\n            </span>\r\n          </div>\r\n          <div className=\"p-6 space-y-4\">\r\n            {/* Data */}\r\n            <div className=\"flex items-center gap-2 text-sm text-gray-500\">\r\n              <Clock size={14} />\r\n              <span>\r\n                {analiseSafe.created_at \r\n                  ? new Date(analiseSafe.created_at).toLocaleDateString('pt-BR')\r\n                  : 'Data não disponível'}\r\n              </span>\r\n            </div>\r\n\r\n            {/* Módulos */}\r\n            {Array.isArray(findings?.selected_modules) && findings.selected_modules.length > 0 && (\r\n              <div>\r\n                <p className=\"text-xs font-bold text-red-800 uppercase tracking-wider mb-2\">Módulos</p>\r\n                <div className=\"flex flex-wrap gap-2\">\r\n                  {findings.selected_modules.map((modId: string, i: number) => (\r\n                    <span key={i} className=\"px-3 py-1 bg-red-50 text-red-800 text-xs font-bold rounded-full border border-red-200\">\r\n                      {MODULE_NAMES[modId] || modId}\r\n                    </span>\r\n                  ))}\r\n                </div>\r\n              </div>\r\n            )}\r\n\r\n            {/* Síntese */}\r\n            <div>\r\n              <p className=\"text-xs font-bold text-gray-500 uppercase tracking-wider mb-2\">Síntese Principal</p>\r\n              <div className=\"bg-gray-50 p-4 rounded-lg border border-gray-100 text-sm text-gray-700 leading-relaxed\">\r\n                {findings?.resumo ? (\r\n                  findings.isHtmlResumo ? (\r\n                    <div dangerouslySetInnerHTML={{ __html: DOMPurify.sanitize(findings.resumo.substring(0, 500)) }} />\r\n                  ) : (\r\n                    <p className=\"whitespace-pre-line\">{findings.resumo.substring(0, 500)}{findings.resumo.length > 500 ? '...' : ''}</p>\r\n                  )\r\n                ) : (\r\n                  <p className=\"text-gray-400 italic\">Síntese não disponível</p>\r\n                )}\r\n              </div>\r\n            </div>\r\n\r\n            {/* Achados */}\r\n            {problemas.length > 0 && (\r\n              <div>\r\n                <p className=\"text-xs font-bold text-gray-500 uppercase tracking-wider mb-2\">Achados Principais ({problemas.length})</p>\r\n                <div className=\"space-y-2\">\r\n                  {problemas.slice(0, 5).map((prob, i) => (\r\n                    <div key={i} className=\"flex items-start gap-2 text-sm\">\r\n                      <AlertTriangle size={14} className=\"text-red-400 mt-0.5 flex-shrink-0\" />\r\n                      <span className=\"text-gray-700\">{prob.titulo || prob.descricao}</span>\r\n                    </div>\r\n                  ))}\r\n                  {problemas.length > 5 && (\r\n                    <p className=\"text-xs text-gray-400 italic\">+{problemas.length - 5} achados adicionais</p>\r\n                  )}\r\n                </div>\r\n              </div>\r\n            )}\r\n          </div>\r\n        </div>\r\n\r\n        {/* B. Análises Complementares */}\r\n        {childAnalyses.map((child, idx) => {\r\n          const childFindings = child.findings as AnalysisFindings;\r\n          const childProblemas = Array.isArray(childFindings?.problemas) ? childFindings.problemas : [];\r\n          const childRecomendacoes = Array.isArray(childFindings?.recomendacoes) ? childFindings.recomendacoes : [];\r\n          const childModules = childFindings?.selected_modules || childFindings?.complementary_modules || [];\r\n          const childRiskLevel = child.risk_level;\r\n\r\n          return (\r\n            <div key={child.id} className=\"mb-8 bg-white border border-blue-200 rounded-xl overflow-hidden shadow-sm\">\r\n              <div className=\"bg-blue-600 text-white px-6 py-4 flex items-center justify-between\">\r\n                <div className=\"flex items-center gap-3\">\r\n                  <FileCheck size={20} />\r\n                  <span className=\"font-bold text-lg\">Análise Complementar {idx + 1}</span>\r\n                </div>\r\n                <span className=\"px-3 py-1 bg-white/20 text-white text-[10px] font-bold uppercase rounded-full\">\r\n                  Camada {(findings?.analysis_depth || 1) + idx + 1}\r\n                </span>\r\n              </div>\r\n              <div className=\"p-6 space-y-4\">\r\n                {/* Data */}\r\n                <div className=\"flex items-center gap-2 text-sm text-gray-500\">\r\n                  <Clock size={14} />\r\n                  <span>\r\n                    {child.created_at\r\n                      ? new Date(child.created_at).toLocaleDateString('pt-BR')\r\n                      : 'Data não disponível'}\r\n                  </span>\r\n                </div>\r\n\r\n                {/* Vínculo com análise pai */}\r\n                <div className=\"bg-blue-50 px-4 py-2 rounded-lg border border-blue-100\">\r\n                  <p className=\"text-xs text-blue-700\">\r\n                    <strong>Vinculada à:</strong> Análise Principal • Ref: ALX-{analiseSafe.id.slice(0, 8).toUpperCase() || '00000000'}\r\n                  </p>\r\n                </div>\r\n\r\n                {/* Módulos */}\r\n                {Array.isArray(childModules) && childModules.length > 0 && (\r\n                  <div>\r\n                    <p className=\"text-xs font-bold text-red-800 uppercase tracking-wider mb-2\">Módulos Processados</p>\r\n                    <div className=\"flex flex-wrap gap-2\">\r\n                      {childModules.map((modId: string, i: number) => (\r\n                        <span key={i} className=\"px-3 py-1 bg-red-50 text-red-800 text-xs font-bold rounded-full border border-red-200\">\r\n                          {MODULE_NAMES[modId] || modId}\r\n                        </span>\r\n                      ))}\r\n                    </div>\r\n                  </div>\r\n                )}\r\n\r\n                {/* Achados específicos */}\r\n                {childProblemas.length > 0 && (\r\n                  <div>\r\n                    <p className=\"text-xs font-bold text-gray-500 uppercase tracking-wider mb-2\">Achados Específicos ({childProblemas.length})</p>\r\n                    <div className=\"space-y-2\">\r\n                      {childProblemas.map((prob, i) => {\r\n                        const c = (prob.criticidade || '').toLowerCase();\r\n                        let badgeColor = 'bg-green-100 text-green-700';\r\n                        if (c.includes('critico')) badgeColor = 'bg-red-100 text-red-700';\r\n                        else if (c.includes('alto')) badgeColor = 'bg-orange-100 text-orange-700';\r\n                        else if (c.includes('medio') || c.includes('médio')) badgeColor = 'bg-yellow-100 text-yellow-700';\r\n\r\n                        return (\r\n                          <div key={i} className=\"bg-gray-50 p-3 rounded-lg border border-gray-100\">\r\n                            <div className=\"flex items-start gap-2\">\r\n                              <AlertTriangle size={14} className=\"text-red-400 mt-1 flex-shrink-0\" />\r\n                              <div className=\"flex-1 min-w-0\">\r\n                                <div className=\"flex items-center gap-2\">\r\n                                  <span className=\"text-sm font-medium text-gray-800\">{prob.titulo || prob.descricao}</span>\r\n                                  {prob.criticidade && (\r\n                                    <span className={`px-2 py-0.5 rounded text-[10px] font-bold ${badgeColor}`}>\r\n                                      {prob.criticidade}\r\n                                    </span>\r\n                                  )}\r\n                                </div>\r\n                                {prob.descricao && prob.descricao !== prob.titulo && (\r\n                                  <p className=\"text-xs text-gray-600 mt-1\">{prob.descricao}</p>\r\n                                )}\r\n                              </div>\r\n                            </div>\r\n                          </div>\r\n                        );\r\n                      })}\r\n                    </div>\r\n                  </div>\r\n                )}\r\n\r\n                {/* Recomendações específicas */}\r\n                {childRecomendacoes.length > 0 && (\r\n                  <div>\r\n                    <p className=\"text-xs font-bold text-gray-500 uppercase tracking-wider mb-2\">Recomendações Específicas</p>\r\n                    <div className=\"bg-green-50 p-4 rounded-lg border border-green-100\">\r\n                      <ul className=\"space-y-2\">\r\n                        {childRecomendacoes.map((rec: string, i: number) => (\r\n                          <li key={i} className=\"flex items-start gap-2 text-sm\">\r\n                            <CheckCircle2 size={14} className=\"text-green-500 mt-0.5 flex-shrink-0\" />\r\n                            <span className=\"text-gray-700\">{rec}</span>\r\n                          </li>\r\n                        ))}\r\n                      </ul>\r\n                    </div>\r\n                  </div>\r\n                )}\r\n\r\n                {/* Documentos Faltantes */}\r\n                {Array.isArray(childFindings?.documentosFaltantes) && childFindings.documentosFaltantes.length > 0 && (\r\n                  <div>\r\n                    <p className=\"text-xs font-bold text-gray-500 uppercase tracking-wider mb-2\">Documentos Necessários</p>\r\n                    <div className=\"space-y-1\">\r\n                      {childFindings.documentosFaltantes.map((doc: string, i: number) => (\r\n                        <div key={i} className=\"flex items-center gap-2 text-sm text-gray-600\">\r\n                          <FileText size={14} className=\"text-orange-400 flex-shrink-0\" />\r\n                          <span>{doc}</span>\r\n                        </div>\r\n                      ))}\r\n                    </div>\r\n                  </div>\r\n                )}\r\n\r\n                {/* Nível de Risco */}\r\n                {childRiskLevel && (\r\n                  <div className=\"flex items-center gap-2 text-sm\">\r\n                    <span className=\"text-gray-500 font-bold\">Nível de Risco:</span>\r\n                    <span className={`px-3 py-1 rounded-full text-xs font-bold ${\r\n                      childRiskLevel.toLowerCase() === 'critico' ? 'bg-red-100 text-red-700' :\r\n                      childRiskLevel.toLowerCase() === 'alto' ? 'bg-orange-100 text-orange-700' :\r\n                      childRiskLevel.toLowerCase() === 'medio' || childRiskLevel.toLowerCase() === 'médio' ? 'bg-yellow-100 text-yellow-700' :\r\n                      'bg-green-100 text-green-700'\r\n                    }`}>\r\n                      {childRiskLevel}\r\n                    </span>\r\n                  </div>\r\n                )}\r\n              </div>\r\n            </div>\r\n          );\r\n        })}\r\n      </section>\r\n    );\r\n  }\r\n\r\n  function renderChecklist() {\r\n    return (\r\n      <section className=\"print:break-inside-avoid border-t-2 border-gray-100 pt-8\">\r\n        <h2 className=\"text-2xl font-bold text-gray-900 mb-4 flex items-center gap-2 border-b border-gray-200 pb-3 uppercase tracking-wide\">\r\n          <FileSignature className=\"text-brand-gold\" size={24} /> Checklist Documental\r\n        </h2>\r\n        <div className=\"space-y-3 print-checklist\">\r\n          {documentosBase.map((doc, i) => {\r\n            const { presente, indicio } = verificarDocumento(doc.chave);\r\n            let statusClass = 'ausente';\r\n            let iconText = '✗';\r\n            let statusText = 'Ausente';\r\n\r\n            if (presente) {\r\n              statusClass = 'presente';\r\n              iconText = '✓';\r\n              statusText = 'Presente';\r\n            } else if (indicio) {\r\n              statusClass = 'indicio';\r\n              iconText = '?';\r\n              statusText = 'Indício';\r\n            }\r\n\r\n            return (\r\n              <div key={i} className=\"checklist-item\">\r\n                <div className={`checklist-icon ${statusClass}`}>{iconText}</div>\r\n                <span className=\"checklist-nome\">{doc.nome}</span>\r\n                <span className={`checklist-status ${statusClass}`}>{statusText}</span>\r\n              </div>\r\n            );\r\n          })}\r\n        </div>\r\n      </section>\r\n    );\r\n  }\r\n\r\n  return (\r\n    <div className=\"min-h-screen bg-gray-50 print:bg-white\">\r\n      {/* Navbar */}\r\n      <nav className=\"bg-brand-green text-white shadow-md print:hidden\">\r\n        <div className=\"container mx-auto px-4 py-4 flex justify-between items-center\">\r\n          <Link href=\"/dashboard\" className=\"flex items-center gap-2 text-brand-gold hover:scale-105 transition-transform\">\r\n            <ShieldCheck size={28} />\r\n            <span className=\"text-xl font-bold text-white\">AgroLex</span>\r\n          </Link>\r\n        </div>\r\n      </nav>\r\n\r\n      {/* CAPA PREMIUM — exclusiva para impressão PDF */}\r\n      <div className=\"hidden print:flex print:flex-col print:items-center print:justify-between print:min-h-[270mm] print:w-full print:px-16 print:py-12 cover-page\">\r\n        {/* TOPO — Logo + Marca (25-35% altura) */}\r\n        <div className=\"flex flex-col items-center justify-center flex-1 min-h-[30vh]\">\r\n          <div className=\"w-44 h-44 bg-brand-green rounded-[32px] flex items-center justify-center shadow-2xl shadow-brand-green/20\">\r\n            <ShieldCheck size={108} className=\"text-brand-gold\" />\r\n          </div>\r\n          <h1 className=\"text-5xl font-black text-gray-900 mt-8 tracking-tight\">AgroLex</h1>\r\n          <p className=\"text-xl text-brand-green font-semibold mt-2 tracking-wider\">Inteligência Fundiária</p>\r\n        </div>\r\n\r\n        <div className=\"border-t-2 border-brand-gold w-32 mx-auto my-6\" />\r\n\r\n        {/* TÍTULO DO DOCUMENTO */}\r\n        <div className=\"text-center\">\r\n          <h2 className=\"text-3xl font-extrabold text-gray-800 leading-snug\">\r\n            Dossiê Técnico<br/>de Auditoria Fundiária\r\n          </h2>\r\n        </div>\r\n\r\n        {/* DADOS DO IMÓVEL */}\r\n        <div className=\"mt-6 text-center space-y-2\">\r\n          <p className=\"text-xl text-gray-700 font-medium flex items-center justify-center gap-2\">\r\n            <MapPin size={20} className=\"text-brand-gold\" />\r\n            {propName} • {propLocation}\r\n          </p>\r\n          <p className=\"text-base text-gray-500\">\r\n            {new Date().toLocaleDateString('pt-BR')}\r\n          </p>\r\n          <p className=\"text-sm text-gray-400 font-mono\">\r\n            Ref: ALX-{analise.id?.slice(0, 8).toUpperCase() || '00000000'}\r\n          </p>\r\n        </div>\r\n\r\n        {/* SCORE + RISCO */}\r\n        <div className=\"mt-8 flex items-center gap-8\">\r\n          <ScoreAgroLex findings={findings} riskLevel={analise.risk_level} size=\"md\" />\r\n          <div className={`${styles.bg} px-6 py-4 rounded-xl border ${styles.border} min-w-[140px] text-center`}>\r\n            <p className={`text-[10px] font-bold ${styles.labelText} uppercase tracking-widest mb-1`}>Grau de Risco</p>\r\n            <div className={`flex items-center gap-2 ${styles.text} justify-center`}>\r\n              <AlertTriangle size={22} />\r\n              <span className=\"text-2xl font-black\">{risco?.toUpperCase()}</span>\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        {/* RODAPÉ INSTITUCIONAL */}\r\n        <div className=\"w-full mt-8 pt-6 border-t border-gray-200 text-center\">\r\n          <p className=\"text-xs text-gray-400 leading-relaxed\">\r\n            AgroLex Inteligência Fundiária • CNPJ: XX.XXX.XXX/XXXX-XX<br/>\r\n            Documento confidencial e de uso interno • Protegido por LGPD\r\n          </p>\r\n        </div>\r\n      </div>\r\n\r\n      <main className=\"container mx-auto px-4 py-8 max-w-4xl print:py-0\">\r\n        <div className=\"flex items-center justify-between mb-6 print:hidden\">\r\n          <Link href=\"/dashboard\" className=\"flex items-center gap-2 text-gray-600 hover:text-brand-green transition-colors w-fit font-medium print:hidden\">\r\n            <ArrowLeft size={20} /> Centro de Inteligência\r\n          </Link>\r\n          <div className=\"flex gap-3\">\r\n            {!isTrialUser && (\r\n              <button onClick={handleExportPDF} className=\"px-5 py-2.5 border-2 border-gray-300 text-gray-700 rounded-xl font-bold hover:bg-gray-50 transition-colors text-sm flex items-center gap-2\">\r\n                <FileText size={16} /> Exportar PDF\r\n              </button>\r\n            )}\r\n            {isTrialUser && (\r\n              <Link href=\"/dashboard/planos\" className=\"px-5 py-2.5 border-2 border-amber-400 text-amber-700 bg-amber-50 rounded-xl font-bold hover:bg-amber-100 transition-colors text-sm flex items-center gap-2\">\r\n                🔒 PDF bloqueado — Ver Planos\r\n              </Link>\r\n            )}\r\n          </div>\r\n        </div>\r\n\r\n        {/* ═══ OBJ 3+4: CARD PREMIUM PARA USUÁRIOS TRIAL ═══ */}\r\n        {isTrialUser && (\r\n          <div className=\"mb-8 bg-gradient-to-br from-amber-50 to-yellow-50 border-2 border-amber-300 rounded-2xl shadow-xl p-8\">\r\n            <div className=\"text-center mb-6\">\r\n              <div className=\"w-16 h-16 bg-amber-100 rounded-full flex items-center justify-center mx-auto mb-4\">\r\n                <CheckCircle2 size={32} className=\"text-amber-600\" />\r\n              </div>\r\n              <h2 className=\"text-2xl font-extrabold text-gray-800 mb-2\">Análise Concluída</h2>\r\n              <p className=\"text-gray-600 max-w-lg mx-auto\">\r\n                Encontramos indícios relevantes que merecem atenção. Desbloqueie o relatório profissional completo para visualizar todos os riscos, inconsistências, cadeia dominial e recomendações.\r\n              </p>\r\n            </div>\r\n\r\n            {/* Indicadores de progresso */}\r\n            <div className=\"bg-white rounded-xl p-5 border border-amber-200 mb-6\">\r\n              <p className=\"text-xs font-bold text-gray-500 uppercase tracking-wider mb-3\">Status da sua análise gratuita</p>\r\n              <div className=\"space-y-2\">\r\n                <div className=\"flex items-center gap-2 text-sm\">\r\n                  <CheckCircle2 size={16} className=\"text-green-500 flex-shrink-0\" />\r\n                  <span className=\"text-green-700 font-medium\">✓ Auditoria realizada</span>\r\n                </div>\r\n                <div className=\"flex items-center gap-2 text-sm\">\r\n                  <CheckCircle2 size={16} className=\"text-green-500 flex-shrink-0\" />\r\n                  <span className=\"text-green-700 font-medium\">✓ Documento processado</span>\r\n                </div>\r\n                <div className=\"flex items-center gap-2 text-sm\">\r\n                  <AlertTriangle size={16} className=\"text-red-500 flex-shrink-0\" />\r\n                  <span className=\"text-red-600 font-medium\">{problemas.length} riscos encontrados</span>\r\n                </div>\r\n                {/* FASE 3: blocked_premium_clicked — relatório completo */}\r\n                <button\r\n                  onClick={() => {\r\n                    registrarEventoComercial('blocked_premium_clicked', { origem: 'indicador_relatorio' });\r\n                    router.push('/dashboard/planos');\r\n                  }}\r\n                  className=\"flex items-center gap-2 text-sm text-left w-full hover:opacity-80 transition-opacity\"\r\n                >\r\n                  <div className=\"w-4 h-4 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0\">\r\n                    <span className=\"text-red-500 text-[10px] font-bold\">🔒</span>\r\n                  </div>\r\n                  <span className=\"text-red-500 font-medium underline decoration-dotted\">🔒 Relatório completo bloqueado</span>\r\n                </button>\r\n                {/* FASE 3: blocked_pdf_clicked — PDF bloqueado */}\r\n                <button\r\n                  onClick={() => {\r\n                    registrarEventoComercial('blocked_pdf_clicked', { origem: 'indicador_pdf' });\r\n                    router.push('/dashboard/planos');\r\n                  }}\r\n                  className=\"flex items-center gap-2 text-sm text-left w-full hover:opacity-80 transition-opacity\"\r\n                >\r\n                  <div className=\"w-4 h-4 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0\">\r\n                    <span className=\"text-red-500 text-[10px] font-bold\">🔒</span>\r\n                  </div>\r\n                  <span className=\"text-red-500 font-medium underline decoration-dotted\">🔒 Exportação PDF bloqueada</span>\r\n                </button>\r\n                {/* FASE 3: blocked_chain_clicked — cadeia dominial bloqueada */}\r\n                <button\r\n                  onClick={() => {\r\n                    registrarEventoComercial('blocked_chain_clicked', { origem: 'indicador_cadeia' });\r\n                    router.push('/dashboard/planos');\r\n                  }}\r\n                  className=\"flex items-center gap-2 text-sm text-left w-full hover:opacity-80 transition-opacity\"\r\n                >\r\n                  <div className=\"w-4 h-4 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0\">\r\n                    <span className=\"text-red-500 text-[10px] font-bold\">🔒</span>\r\n                  </div>\r\n                  <span className=\"text-red-500 font-medium underline decoration-dotted\">🔒 Cadeia dominial bloqueada</span>\r\n                </button>\r\n                <div className=\"flex items-center gap-2 text-sm\">\r\n                  <div className=\"w-4 h-4 rounded-full bg-red-100 flex items-center justify-center\">\r\n                    <span className=\"text-red-500 text-[10px] font-bold\">🔒</span>\r\n                  </div>\r\n                  <span className=\"text-red-500 font-medium\">🔒 Módulos avançados bloqueados</span>\r\n                </div>\r\n              </div>\r\n            </div>\r\n\r\n            {/* Contador visual */}\r\n            <div className=\"bg-amber-100 border border-amber-300 rounded-xl p-4 mb-6 text-center\">\r\n              <p className=\"text-sm font-bold text-amber-800\">\r\n                Você está visualizando apenas uma prévia da análise.\r\n              </p>\r\n            </div>\r\n\r\n            {/* CTA — FASE 3: registra blocked_premium_clicked */}\r\n            <button\r\n              onClick={() => {\r\n                registrarEventoComercial('blocked_premium_clicked', { origem: 'card_premium_trial' });\r\n                setSelectedPlanForModal('Profissional');\r\n                setIsModalOpen(true);\r\n              }}\r\n              className=\"w-full bg-brand-gold text-brand-green py-4 rounded-xl font-extrabold text-lg text-center hover:brightness-110 transition-all shadow-lg\"\r\n            >\r\n              Desbloquear Relatório Completo\r\n            </button>\r\n          </div>\r\n        )}\r\n\r\n        {/* Card Principal do Dossiê */}\r\n        <div className=\"bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden print:shadow-none print:border print:rounded-none\">\r\n          \r\n          {/* HEADER PROFISSIONAL — oculto no print para não gerar página 2 vazia após a capa */}\r\n          <div className=\"p-8 border-b border-gray-100 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 print:hidden print:border-b bg-gradient-to-r from-gray-50 to-white\">\r\n            <div>\r\n              <div className=\"flex items-center gap-3 mb-2\">\r\n                <h1 className=\"text-2xl md:text-3xl font-extrabold text-gray-800\">Dossiê Técnico de Auditoria Fundiária</h1>\r\n                <span className=\"px-3 py-1.5 bg-green-100 text-green-700 rounded-full text-[10px] font-bold uppercase tracking-wider shadow-sm print:shadow-none flex items-center gap-1\">\r\n                  <CheckCircle2 size={12} /> Parecer Final\r\n                </span>\r\n              </div>\r\n              <div className=\"flex items-center gap-4 text-sm text-gray-500 mt-1\">\r\n                <span className=\"flex items-center gap-1\"><MapPin size={14} className=\"text-brand-gold\" /> {propName} • {propLocation}</span>\r\n                <span className=\"flex items-center gap-1\"><Clock size={14} className=\"text-brand-gold\" /> {new Date().toLocaleDateString('pt-BR')}</span>\r\n                <span className=\"flex items-center gap-1\"><ShieldCheck size={14} className=\"text-brand-gold\" /> ALX-{analise.id?.slice(0, 8).toUpperCase() || '00000000'}</span>\r\n              </div>\r\n            </div>\r\n            <div className={`text-center ${styles.bg} p-4 rounded-xl border ${styles.border} shadow-sm print:shadow-none print:border min-w-[130px]`}>\r\n              <p className={`text-[10px] font-bold ${styles.labelText} uppercase tracking-widest mb-1`}>Grau de Risco</p>\r\n              <div className={`flex items-center gap-2 ${styles.text} justify-center`}>\r\n                <AlertTriangle size={22} />\r\n                <span className=\"text-2xl font-black\">{risco?.toUpperCase()}</span>\r\n              </div>\r\n            </div>\r\n          </div>\r\n\r\n          {/* CORPO DO DOSSIÊ */}\r\n          <div className=\"p-8 space-y-10 print:p-4 report-text\">\r\n\r\n            {/* 1. SCORE AGROLEX + RESUMO EXECUTIVO */}\r\n            <section className=\"print:break-inside-avoid\">\r\n              {/* SCORE — centralizado na tela, oculto no print */}\r\n              <div className=\"flex justify-center mb-8 print:hidden\">\r\n                <ScoreAgroLex findings={findings} riskLevel={analise.risk_level} size=\"lg\" />\r\n              </div>\r\n\r\n              {/* RESUMO EXECUTIVO — largura total na tela; no print mantém baseline */}\r\n              <div className=\"print:flex print:flex-col print:items-center print:gap-4\">\r\n                <div className=\"print:w-full\">\r\n                  <h2 className=\"text-2xl font-bold text-gray-900 mb-4 flex items-center gap-2 border-b border-gray-300 pb-3 uppercase tracking-wide\">\r\n                    <FileText className=\"text-brand-gold\" size={24} /> Resumo Executivo\r\n                  </h2>\r\n                  {findings!.isHtmlResumo ? (\r\n                    <div \r\n                      className=\"text-gray-700 leading-relaxed text-base print:bg-white text-justify\"\r\n                      dangerouslySetInnerHTML={{ __html: sanitizedResumo }} \r\n                    />\r\n                  ) : (\r\n                    <p className=\"text-gray-700 leading-relaxed text-base print:bg-white whitespace-pre-line text-justify hyphens-auto\">\r\n                      {findings!.resumo}\r\n                    </p>\r\n                  )}\r\n                </div>\r\n              </div>\r\n            </section>\r\n\r\n            {/* 2. ACHADOS CRÍTICOS — Indicadores */}\r\n            <section className=\"print:break-inside-avoid border-t-2 border-gray-100 pt-8\">\r\n              <h2 className=\"text-2xl font-bold text-gray-900 mb-4 flex items-center gap-2 border-b border-gray-200 pb-3 uppercase tracking-wide\">\r\n                <AlertTriangle className=\"text-red-500\" size={24} /> Achados Críticos\r\n              </h2>\r\n              \r\n              {/* Cards de resumo de criticidade */}\r\n              <div className=\"grid grid-cols-4 gap-4 mb-8\">\r\n                <div className=\"bg-red-50 rounded-xl p-4 border border-red-200 text-center\">\r\n                  <p className=\"text-3xl font-black text-red-600\">{achadosCriticos}</p>\r\n                  <p className=\"text-[11px] font-bold text-red-700 uppercase tracking-wider mt-1\">Crítico</p>\r\n                </div>\r\n                <div className=\"bg-orange-50 rounded-xl p-4 border border-orange-200 text-center\">\r\n                  <p className=\"text-3xl font-black text-orange-600\">{achadosAltos}</p>\r\n                  <p className=\"text-[11px] font-bold text-orange-700 uppercase tracking-wider mt-1\">Alto</p>\r\n                </div>\r\n                <div className=\"bg-yellow-50 rounded-xl p-4 border border-yellow-200 text-center\">\r\n                  <p className=\"text-3xl font-black text-yellow-600\">{achadosMedios}</p>\r\n                  <p className=\"text-[11px] font-bold text-yellow-700 uppercase tracking-wider mt-1\">Médio</p>\r\n                </div>\r\n                <div className=\"bg-green-50 rounded-xl p-4 border border-green-200 text-center\">\r\n                  <p className=\"text-3xl font-black text-green-600\">{problemas.length}</p>\r\n                  <p className=\"text-[11px] font-bold text-green-700 uppercase tracking-wider mt-1\">Total</p>\r\n                </div>\r\n              </div>\r\n\r\n              {/* Matriz de Risco Visual */}\r\n              <div className=\"grid md:grid-cols-2 gap-8 mb-8\">\r\n                <div>\r\n                  <h3 className=\"text-sm font-bold text-gray-700 mb-3 uppercase tracking-wider\">Matriz de Risco</h3>\r\n                  <div className=\"matriz-risco\">\r\n                    {matrizRiscoGrid().map((cell, i) => (\r\n                      <div key={i} className={`matriz-risco-cell risco-${cell.risco}`} title={`${cell.risco.charAt(0).toUpperCase() + cell.risco.slice(1)} — Probabilidade ${cell.col + 1}, Impacto ${cell.row + 1}`} />\r\n                    ))}\r\n                  </div>\r\n                  <div className=\"flex gap-4 mt-3 text-[10px] text-gray-500 font-medium\">\r\n                    <span className=\"flex items-center gap-1\"><span className=\"w-2.5 h-2.5 rounded-sm bg-green-200 inline-block\" /> Baixo</span>\r\n                    <span className=\"flex items-center gap-1\"><span className=\"w-2.5 h-2.5 rounded-sm bg-yellow-200 inline-block\" /> Médio</span>\r\n                    <span className=\"flex items-center gap-1\"><span className=\"w-2.5 h-2.5 rounded-sm bg-red-200 inline-block\" /> Alto</span>\r\n                    <span className=\"flex items-center gap-1\"><span className=\"w-2.5 h-2.5 rounded-sm bg-red-300 inline-block\" /> Crítico</span>\r\n                  </div>\r\n                </div>\r\n                <div>\r\n                  <h3 className=\"text-sm font-bold text-gray-700 mb-3 uppercase tracking-wider\">Distribuição por Criticidade</h3>\r\n                  <div className=\"space-y-3\">\r\n                    <div>\r\n                      <div className=\"flex justify-between text-xs font-medium text-gray-600 mb-1\">\r\n                        <span>Crítico</span>\r\n                        <span>{achadosCriticos}</span>\r\n                      </div>\r\n                      <div className=\"w-full bg-gray-100 rounded-full h-2\">\r\n                        <div className=\"bg-red-500 h-2 rounded-full\" style={{ width: `${problemas.length > 0 ? (achadosCriticos / problemas.length) * 100 : 0}%` }} />\r\n                      </div>\r\n                    </div>\r\n                    <div>\r\n                      <div className=\"flex justify-between text-xs font-medium text-gray-600 mb-1\">\r\n                        <span>Alto</span>\r\n                        <span>{achadosAltos}</span>\r\n                      </div>\r\n                      <div className=\"w-full bg-gray-100 rounded-full h-2\">\r\n                        <div className=\"bg-orange-500 h-2 rounded-full\" style={{ width: `${problemas.length > 0 ? (achadosAltos / problemas.length) * 100 : 0}%` }} />\r\n                      </div>\r\n                    </div>\r\n                    <div>\r\n                      <div className=\"flex justify-between text-xs font-medium text-gray-600 mb-1\">\r\n                        <span>Médio</span>\r\n                        <span>{achadosMedios}</span>\r\n                      </div>\r\n                      <div className=\"w-full bg-gray-100 rounded-full h-2\">\r\n                        <div className=\"bg-yellow-500 h-2 rounded-full\" style={{ width: `${problemas.length > 0 ? (achadosMedios / problemas.length) * 100 : 0}%` }} />\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n\r\n              {/* Lista de Achados */}\r\n              <ul className=\"space-y-4\">\r\n                {(isTrialUser ? problemas.slice(0, 3) : problemas).map((prob: ReportProblem, i: number) => {\r\n                  const titulo = prob.titulo || prob.descricao || 'Problema identificado';\r\n                  const descricao = prob.descricao && prob.descricao !== prob.titulo ? prob.descricao : null;\r\n                  const c = (prob.criticidade || '').toLowerCase();\r\n\r\n                  let cardBg = 'bg-green-50 border-green-200';\r\n                  let badgeBg = 'bg-green-200 text-green-900';\r\n                  let semaforo = 'bg-green-500';\r\n                  let Icon = CheckCircle2;\r\n\r\n                  if (c.includes('critico')) {\r\n                    cardBg = 'bg-red-50 border-red-200';\r\n                    badgeBg = 'bg-red-200 text-red-900';\r\n                    semaforo = 'bg-red-500';\r\n                    Icon = AlertTriangle;\r\n                  } else if (c.includes('alto')) {\r\n                    cardBg = 'bg-orange-50 border-orange-200';\r\n                    badgeBg = 'bg-orange-200 text-orange-900';\r\n                    semaforo = 'bg-orange-500';\r\n                    Icon = AlertCircle;\r\n                  } else if (c.includes('medio') || c.includes('médio')) {\r\n                    cardBg = 'bg-yellow-50 border-yellow-200';\r\n                    badgeBg = 'bg-yellow-200 text-yellow-900';\r\n                    semaforo = 'bg-yellow-500';\r\n                    Icon = AlertCircle;\r\n                  }\r\n\r\n                  return (\r\n                    <li key={i} className={`${cardBg} p-4 rounded-xl border shadow-sm print:shadow-none print:bg-white ${c.includes('critico') ? 'border-l-4 border-l-red-400' : c.includes('alto') ? 'border-l-4 border-l-orange-400' : c.includes('medio') || c.includes('médio') ? 'border-l-4 border-l-yellow-400' : 'border-l-4 border-l-green-400'}`}>\r\n                      <div className=\"flex items-start gap-3 mb-2\">\r\n                        <div className={`w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0 ${badgeBg}`}>\r\n                          <Icon size={14} />\r\n                        </div>\r\n                        <div className=\"flex-1 min-w-0\">\r\n                          <div className=\"flex items-center gap-2 mb-1\">\r\n                            <span className=\"text-sm font-bold text-gray-900 leading-tight\">{titulo}</span>\r\n                            <span className={`inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold ${badgeBg}`}>\r\n                              <span className={`w-1 h-1 rounded-full ${semaforo}`} />\r\n                              {prob.criticidade}\r\n                            </span>\r\n                          </div>\r\n                          {descricao && (\r\n                            <p className=\"text-sm text-gray-600 mt-1\">{descricao}</p>\r\n                          )}\r\n                        </div>\r\n                      </div>\r\n                      <div className=\"ml-9 space-y-1.5\">\r\n                        {prob.baseDocumental && (\r\n                          <div className=\"flex items-start gap-2 text-xs\">\r\n                            <span className=\"font-bold text-gray-500 flex-shrink-0\">Base:</span>\r\n                            <span className=\"text-gray-600\">{prob.baseDocumental}</span>\r\n                          </div>\r\n                        )}\r\n                        {prob.documentoNecessario && (\r\n                          <div className=\"flex items-start gap-2 text-xs\">\r\n                            <span className=\"font-bold text-gray-500 flex-shrink-0\">Documento:</span>\r\n                            <span className=\"text-gray-600\">{prob.documentoNecessario}</span>\r\n                          </div>\r\n                        )}\r\n                        {prob.recomendacao && (\r\n                          <div className=\"flex items-start gap-2 text-xs\">\r\n                            <span className=\"font-bold text-gray-500 flex-shrink-0\">Recomendação:</span>\r\n                            <span className=\"text-gray-600\">{prob.recomendacao}</span>\r\n                          </div>\r\n                        )}\r\n                      </div>\r\n                    </li>\r\n                  );\r\n                })}\r\n              </ul>\r\n\r\n              {isTrialUser && problemas.length > 3 && (\r\n                <div className=\"mt-4 p-4 bg-gray-50 border border-dashed border-gray-300 rounded-xl text-center\">\r\n                  <p className=\"text-sm text-gray-500 italic\">\r\n                    + {problemas.length - 3} riscos adicionais ocultados na versão de teste.\r\n                  </p>\r\n                </div>\r\n              )}\r\n            </section>\r\n\r\n            {isTrialUser && (\r\n              <section className=\"p-8 bg-gradient-to-br from-amber-50/80 to-yellow-50/50 border border-amber-300 rounded-2xl shadow-sm text-center my-8 space-y-6\">\r\n                <div className=\"border-l-4 border-red-500 bg-red-50 p-4 rounded-r-xl text-left\">\r\n                  <h4 className=\"text-red-800 font-extrabold text-sm uppercase tracking-wide\">ATENÇÃO</h4>\r\n                  <p className=\"text-gray-700 text-sm mt-1 leading-relaxed\">\r\n                    Sua análise identificou sinais relevantes que podem impactar a segurança jurídica deste imóvel.\r\n                  </p>\r\n                  <p className=\"text-gray-700 text-sm mt-1.5 leading-relaxed font-semibold\">\r\n                    O AgroLex encontrou informações que merecem análise detalhada antes de qualquer compra, venda, financiamento ou regularização.\r\n                  </p>\r\n                </div>\r\n                \r\n                {/* Barra de Valor do Relatório */}\r\n                <div className=\"max-w-md mx-auto bg-white border border-amber-200 rounded-xl p-5 shadow-sm\">\r\n                  <div className=\"flex justify-between text-xs font-bold text-amber-800 mb-2\">\r\n                    <span>Relatório liberado: 20%</span>\r\n                    <span>80% das informações permanecem protegidas.</span>\r\n                  </div>\r\n                  <div className=\"w-full bg-gray-100 rounded-full h-4 overflow-hidden flex border border-gray-200\">\r\n                    <div className=\"bg-amber-500 h-full w-[20%]\" />\r\n                    <div className=\"bg-gray-200 h-full flex-1 animate-pulse\" />\r\n                  </div>\r\n                  <p className=\"text-[11px] text-gray-400 mt-2 font-mono\">\r\n                    [████░░░░░░░░░░░░░░]\r\n                  </p>\r\n                </div>\r\n\r\n                {/* Gatilho de Perda */}\r\n                <div className=\"max-w-md mx-auto bg-white border border-amber-200 rounded-xl p-5 shadow-sm text-left\">\r\n                  <p className=\"text-xs font-bold text-gray-500 uppercase tracking-wider mb-3\">O que você ainda NÃO viu:</p>\r\n                  <ul className=\"space-y-2.5 text-sm\">\r\n                    <li className=\"flex items-center gap-2 text-gray-700 font-medium\">\r\n                      <span className=\"text-amber-500\">✓</span> Análise dominial completa\r\n                    </li>\r\n                    <li className=\"flex items-center gap-2 text-gray-700 font-medium\">\r\n                      <span className=\"text-amber-500\">✓</span> Cronologia registral detalhada\r\n                    </li>\r\n                    <li className=\"flex items-center gap-2 text-gray-700 font-medium\">\r\n                      <span className=\"text-amber-500\">✓</span> Inconsistências documentais\r\n                    </li>\r\n                    <li className=\"flex items-center gap-2 text-gray-700 font-medium\">\r\n                      <span className=\"text-amber-500\">✓</span> Riscos ocultos identificados\r\n                    </li>\r\n                    <li className=\"flex items-center gap-2 text-gray-700 font-medium\">\r\n                      <span className=\"text-amber-500\">✓</span> Recomendações jurídicas\r\n                    </li>\r\n                    <li className=\"flex items-center gap-2 text-gray-700 font-medium\">\r\n                      <span className=\"text-amber-500\">✓</span> Estratégia de mitigação de riscos\r\n                    </li>\r\n                  </ul>\r\n                </div>\r\n\r\n                {/* Gatilho de Credibilidade */}\r\n                <div className=\"max-w-md mx-auto bg-gray-50 border border-gray-200 rounded-xl p-5 text-left\">\r\n                  <p className=\"text-xs font-bold text-gray-500 uppercase tracking-wider mb-3\">Como o AgroLex trabalha</p>\r\n                  <ul className=\"space-y-2 text-xs text-gray-600\">\r\n                    <li className=\"flex items-center gap-2\">\r\n                      <span className=\"text-brand-green font-bold\">✓</span> Análise automatizada de documentos\r\n                    </li>\r\n                    <li className=\"flex items-center gap-2\">\r\n                      <span className=\"text-brand-green font-bold\">✓</span> Verificação de inconsistências registrais\r\n                    </li>\r\n                    <li className=\"flex items-center gap-2\">\r\n                      <span className=\"text-brand-green font-bold\">✓</span> Avaliação de riscos fundiários\r\n                    </li>\r\n                    <li className=\"flex items-center gap-2\">\r\n                      <span className=\"text-brand-green font-bold\">✓</span> Organização técnica dos achados\r\n                    </li>\r\n                    <li className=\"flex items-center gap-2\">\r\n                      <span className=\"text-brand-green font-bold\">✓</span> Relatório estruturado para tomada de decisão\r\n                    </li>\r\n                  </ul>\r\n                </div>\r\n\r\n                {/* Gatilho de Urgência */}\r\n                <div className=\"max-w-md mx-auto bg-amber-100/50 border border-amber-200 rounded-xl p-4 text-center\">\r\n                  <p className=\"text-xs font-bold text-amber-800 leading-relaxed\">\r\n                    Quanto mais cedo os riscos são identificados, menor o custo para corrigir problemas futuros.\r\n                  </p>\r\n                </div>\r\n\r\n                <div className=\"pt-2\">\r\n                  <button\r\n                    onClick={() => {\r\n                      registrarEventoComercial('blocked_premium_clicked', { origem: 'resultado_parcial_bar' });\r\n                      // Telemetria do click\r\n                      supabase.auth.getSession().then(({ data: { session } }) => {\r\n                        if (session) {\r\n                          fetch('/api/marketing/leads', {\r\n                            method: 'POST',\r\n                            headers: { 'Content-Type': 'application/json' },\r\n                            body: JSON.stringify({\r\n                              action: 'track_event',\r\n                              userId: session.user.id,\r\n                              email: session.user.email,\r\n                              eventType: 'upgrade_cta_click',\r\n                              meta: { origem: 'resultado_parcial_bar', analysisId: analise.id }\r\n                            })\r\n                          });\r\n                        }\r\n                      });\r\n                      setSelectedPlanForModal('Profissional');\r\n                      setIsModalOpen(true);\r\n                    }}\r\n                    className=\"w-full max-w-md bg-brand-gold text-brand-green py-4 rounded-xl font-extrabold text-lg text-center hover:brightness-110 transition-all shadow-md\"\r\n                  >\r\n                    Quero Ver o Relatório Completo\r\n                  </button>\r\n                </div>\r\n              </section>\r\n            )}\r\n\r\n            {/* 3. TIMELINE */}\r\n            {!isTrialUser && safeLinhaDoTempo.length > 0 && (\r\n              <section className=\"print:break-inside-avoid border-t-2 border-gray-100 pt-8\">\r\n                <h2 className=\"text-2xl font-bold text-gray-900 mb-4 flex items-center gap-2 border-b border-gray-200 pb-3 uppercase tracking-wide\">\r\n                  <Clock className=\"text-brand-gold\" size={24} /> Timeline Registral\r\n                </h2>\r\n                <div className=\"timeline-premium\">\r\n                  {safeLinhaDoTempo.map((item: TimelineEvent, i: number) => (\r\n                    <div key={i} className=\"timeline-premium-item\">\r\n                      <div className=\"timeline-premium-dot\"></div>\r\n                      <div className=\"timeline-premium-content\">\r\n                        <span className=\"inline-block px-2.5 py-1 bg-brand-gold text-brand-green font-black text-xs rounded-md mb-2 shadow-sm\">{item.data}</span>\r\n                        <h3 className=\"text-base font-bold text-gray-800 mb-1\">{item.evento}</h3>\r\n                        <p className=\"text-gray-600 text-sm leading-relaxed\">{item.detalhe}</p>\r\n                      </div>\r\n                    </div>\r\n                  ))}\r\n                </div>\r\n              </section>\r\n            )}\r\n\r\n            {/* 4. RECOMENDAÇÕES TÉCNICAS */}\r\n            {!isTrialUser && (\r\n              <section className=\"print:break-inside-avoid border-t-2 border-gray-100 pt-8\">\r\n                <h2 className=\"text-2xl font-bold text-gray-900 mb-4 flex items-center gap-2 border-b border-gray-200 pb-3 uppercase tracking-wide\">\r\n                  <CheckCircle2 className=\"text-brand-green\" size={24} /> Recomendações Técnicas\r\n                </h2>\r\n                <div className=\"bg-gradient-to-br from-green-50 to-emerald-50 p-6 rounded-2xl border border-green-200 shadow-sm print:shadow-none print:bg-white print:border\">\r\n                  <ul className=\"space-y-4\">\r\n                    {safeRecomendacoes.map((rec: string, i: number) => (\r\n                      <li key={i} className=\"flex items-start gap-3\">\r\n                        <div className=\"w-6 h-6 rounded-full bg-green-200 flex items-center justify-center flex-shrink-0 mt-0.5\">\r\n                          <CheckCircle2 size={14} className=\"text-green-700\" />\r\n                        </div>\r\n                        <span className=\"text-gray-800 font-medium\">{rec}</span>\r\n                      </li>\r\n                    ))}\r\n                  </ul>\r\n                </div>\r\n              </section>\r\n            )}\r\n\r\n            {/* 5. DOCUMENTOS FALTANTES */}\r\n            {!isTrialUser && (\r\n              <section className=\"print:break-inside-avoid border-t-2 border-gray-100 pt-8\">\r\n                <h2 className=\"text-2xl font-bold text-gray-900 mb-4 flex items-center gap-2 border-b border-gray-200 pb-3 uppercase tracking-wide\">\r\n                  <FileText className=\"text-orange-500\" size={24} /> Documentos Necessários\r\n                </h2>\r\n                <ul className=\"space-y-3\">\r\n                  {safeDocumentosFaltantes.map((doc: string, i: number) => (\r\n                    <li key={i} className=\"flex items-center gap-4 bg-orange-50 p-4 rounded-xl border border-orange-100 shadow-sm print:shadow-none print:bg-white\">\r\n                      <div className=\"w-8 h-8 bg-orange-200 rounded-lg flex items-center justify-center flex-shrink-0\">\r\n                        <FileText size={16} className=\"text-orange-700\" />\r\n                      </div>\r\n                      <span className=\"text-orange-900 font-medium\">{doc}</span>\r\n                    </li>\r\n                  ))}\r\n                  {(safeDocumentosFaltantes.length === 0) && (\r\n                    <li className=\"text-gray-500 italic p-4\">Nenhum documento pendente identificado.</li>\r\n                  )}\r\n                </ul>\r\n              </section>\r\n            )}\r\n\r\n            {/* 5b. CADEIA DOMINIAL VISUAL — Fluxo Visual Law */}\r\n            {!isTrialUser && renderCadeiaDominial()}\r\n\r\n            {/* 5c. RADAR DE RISCO AGROLEX — v2 (ISF) */}\r\n            <section className=\"print:break-inside-avoid border-t-2 border-gray-100 pt-8\">\r\n              <h2 className=\"text-2xl font-bold text-gray-900 mb-4 flex items-center gap-2 border-b border-gray-200 pb-3 uppercase tracking-wide\">\r\n                <Search className=\"text-brand-gold\" size={24} /> Radar de Risco AgroLex\r\n              </h2>\r\n              <LocalErrorBoundary title=\"Não foi possível carregar o gráfico do radar\">\r\n                <RadarChartV2 isfEixos={analise.isf_eixos} />\r\n              </LocalErrorBoundary>\r\n            </section>\r\n\r\n            {/* 5d. EXPLICABILIDADE ISF v2 — SPRINT 3 */}\r\n            <LocalErrorBoundary title=\"Não foi possível carregar o detalhamento dos eixos\">\r\n              <ISFExplainer\r\n                isfAchados={analise.isf_achados}\r\n                problemasFallback={findings?.problemas}\r\n              />\r\n            </LocalErrorBoundary>\r\n\r\n            {/* 5e. CHECKLIST DOCUMENTAL INTELIGENTE */}\r\n            {renderChecklist()}\r\n\r\n            {/* 6. CHECKLIST DA CADEIA DOMINIAL */}\r\n            {!isTrialUser && safeChecklist.length > 0 && (\r\n              <section className=\"print:break-inside-avoid border-t-2 border-gray-100 pt-8\">\r\n                <h2 className=\"text-2xl font-bold text-gray-900 mb-4 flex items-center gap-2 border-b border-gray-200 pb-3 uppercase tracking-wide\">\r\n                  <Scale className=\"text-brand-gold\" size={24} /> Auditoria da Cadeia Dominial\r\n                </h2>\r\n                <div className=\"grid md:grid-cols-2 gap-4\">\r\n                  {safeChecklist.map((item: ChecklistItem, i: number) => {\r\n               