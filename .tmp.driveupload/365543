{"version":3,"sources":["../../../src/lib/pdf/pageCounter.server.ts"],"sourcesContent":["export async function countPdfPagesFromBuffer(buffer: Buffer): Promise<number> {\n  try {\n    // Abordagem super rápida nativa: procura por marcações de página no binário do PDF\n    // Evita crashes com bibliotecas CJS incompatíveis com o Turbopack no Edge/Node\n    const bufferString = buffer.toString('binary');\n    const matches = bufferString.match(/\\/Type[\\s]*\\/Page[^s]/g);\n    \n    if (matches && matches.length > 0) {\n      return matches.length;\n    }\n    \n    // Fallback conservador se o PDF for muito ofuscado\n    return 1;\n  } catch (error) {\n    console.error(\"Erro no countPdfPagesFromBuffer:\", error);\n    return 1;\n  }\n}\n"],"names":["countPdfPagesFromBuffer","buffer","bufferString","toString","matches","match","length","error","console"],"mappings":"uCAAO,eAAeA,EAAwBC,CAAc,EAC1D,GAAI,CAIF,IAAMG,EADeH,AACLC,EADYC,QAAQ,CAAC,UACRE,KAAK,CAAC,0BAEnC,GAAID,GAAWA,EAAQE,MAAM,CAAG,EAC9B,CADiC,MAC1BF,EAAQE,MAAM,CAIvB,OAAO,CACT,CAAE,MAAOC,EAAO,CAEd,OADAC,QAAQD,KAAK,CAAC,mCAAoCA,GAC3C,CACT,CACF"}